<%@ page contentType="text/html;charset=UTF-8" language="java" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<head><title>Chi tiết báo cáo — Manager</title></head><main class="pc-page"><div class="editorial-container pc-container-admin"><jsp:include page="fragments/manager-navbar.jsp"/><jsp:include page="fragments/manager-messages.jsp"/><a href="${pageContext.request.contextPath}/manager/reports">← Danh sách</a><h1 class="editorial-title">Báo cáo #${report.id}</h1>
<div class="pc-card"><p><strong>Người báo cáo:</strong> <c:out value="${report.reporter.fullName}"/></p><p><strong>Đối tượng:</strong> <c:out value="${report.reportedUser.fullName}"/></p><p><strong>Booking:</strong> <c:out value="${report.booking.id}"/></p><c:if test="${not empty report.booking && not empty report.booking.photographerProfile}"><p><strong>Hồ sơ nhiếp ảnh gia:</strong> <a class="btn btn-outline-primary btn-sm ms-2" href="${pageContext.request.contextPath}/manager/photographers/${report.booking.photographerProfile.id}">Xem &amp; quản lý hồ sơ #${report.booking.photographerProfile.id}</a></p></c:if><p><strong>Loại:</strong> <c:out value="${report.category}"/></p><p><strong>Nội dung:</strong> <c:out value="${report.details}"/></p><p><strong>Trạng thái:</strong> <c:out value="${report.status}"/></p><p><strong>Điều tra:</strong> <c:out value="${report.investigationNotes}"/></p><p><strong>Kết luận:</strong> <c:out value="${report.resolutionReason}"/></p></div>
<c:if test="${report.status == 'PENDING'}"><form class="pc-card mt-3" method="post" action="${pageContext.request.contextPath}/manager/reports/${report.id}/investigate"><%@ include file="fragments/csrf-input.jsp" %><label for="investigation">Ghi chú bắt đầu điều tra</label><textarea id="investigation" name="notes" required maxlength="1500" class="form-control"></textarea><button class="btn btn-primary mt-2">Nhận xử lý</button></form></c:if>
<c:if test="${report.status == 'INVESTIGATING'}"><form class="pc-card mt-3" method="post" action="${pageContext.request.contextPath}/manager/reports/${report.id}/resolve"><%@ include file="fragments/csrf-input.jsp" %><label>Kết quả</label><select name="outcome" class="form-select"><option value="RESOLVED">RESOLVED</option><option value="DISMISSED">DISMISSED</option></select><label for="resolutionReason">Lý do kết luận</label><textarea id="resolutionReason" name="reason" required maxlength="1000" class="form-control"></textarea><label for="internalNotes">Ghi chú nội bộ</label><textarea id="internalNotes" name="notes" maxlength="1000" class="form-control"></textarea><button class="btn btn-primary mt-2">Hoàn tất</button></form></c:if>
</div></main>
