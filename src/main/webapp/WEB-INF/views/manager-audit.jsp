<%@ page contentType="text/html;charset=UTF-8" language="java" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<head><title>Nhật ký hoạt động — Manager</title></head><main class="pc-page"><div class="editorial-container pc-container-admin"><jsp:include page="fragments/manager-navbar.jsp"/><h1 class="editorial-title">Nhật ký hoạt động</h1><p class="text-muted">Bản ghi chỉ đọc; không có endpoint sửa hoặc xóa.</p><div class="admin-table-shell"><table class="admin-table"><thead><tr><th>Thời gian</th><th>Actor</th><th>Vai trò</th><th>Hành động</th><th>Đối tượng</th><th>Kết quả</th><th>Tóm tắt</th></tr></thead><tbody><c:forEach var="log" items="${logs}"><tr><td><c:out value="${log.createdAt}"/></td><td><c:out value="${log.actor.fullName}"/></td><td><c:out value="${log.actorRole}"/></td><td><c:out value="${log.action}"/></td><td><c:out value="${log.targetType}"/> #<c:out value="${log.targetId}"/></td><td><c:out value="${log.outcome}"/></td><td><c:out value="${log.summary}"/></td></tr></c:forEach><c:if test="${empty logs}"><tr><td colspan="7">Chưa có nhật ký.</td></tr></c:if></tbody></table></div></div></main>
