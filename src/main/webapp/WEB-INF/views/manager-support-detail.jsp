<%@ page contentType="text/html;charset=UTF-8" language="java" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<head><title>Support Ticket Details — Manager</title></head><main class="pc-page"><div class="editorial-container pc-container-admin"><jsp:include page="fragments/manager-navbar.jsp"/><jsp:include page="fragments/manager-messages.jsp"/><a href="${pageContext.request.contextPath}/manager/support">← Back to List</a><h1 class="editorial-title">Ticket #${ticket.id}</h1>
<div class="pc-card"><p><strong>Requester:</strong> <c:out value="${ticket.requester.fullName}"/></p><p><strong>Category:</strong> <c:out value="${ticket.category}"/></p><p><strong>Subject:</strong> <c:out value="${ticket.subject}"/></p><p><strong>Description:</strong> <c:out value="${ticket.description}"/></p><p><strong>Status:</strong> <c:out value="${ticket.status}"/></p><p><strong>Assigned Manager:</strong> <c:out value="${ticket.assignedManager.fullName}"/></p></div>
<h2 class="h4 mt-4">Conversation Thread</h2><div class="pc-card"><c:forEach var="m" items="${messages}"><div class="border-bottom py-2"><strong><c:out value="${m.author.fullName}"/></strong> <small><c:out value="${m.createdAt}"/></small><div><c:out value="${m.message}"/></div></div></c:forEach><c:if test="${empty messages}"><p class="text-muted">No responses yet.</p></c:if></div>
<c:if test="${empty ticket.assignedManager && ticket.status != 'RESOLVED'}"><form method="post" action="${pageContext.request.contextPath}/manager/support/${ticket.id}/assign" class="mt-3"><%@ include file="fragments/csrf-input.jsp" %><button class="btn btn-primary">Claim Ticket</button></form></c:if>
<c:if test="${not empty ticket.assignedManager && ticket.assignedManager.id == sessionScope.userId && ticket.status != 'RESOLVED'}"><div class="row g-3 mt-2"><div class="col-md-6"><form method="post" action="${pageContext.request.contextPath}/manager/support/${ticket.id}/reply" class="pc-card"><%@ include file="fragments/csrf-input.jsp" %><label for="reply">Reply</label><textarea id="reply" name="message" required maxlength="2000" class="form-control"></textarea><button class="btn btn-secondary mt-2">Send Reply</button></form></div><div class="col-md-6"><form method="post" action="${pageContext.request.contextPath}/manager/support/${ticket.id}/resolve" class="pc-card"><%@ include file="fragments/csrf-input.jsp" %><label for="resolution">Resolution Summary</label><textarea id="resolution" name="message" required maxlength="2000" class="form-control"></textarea><button class="btn btn-primary mt-2">Resolve Ticket</button></form></div></div></c:if>
</div></main>
