<%@ page contentType="text/html;charset=UTF-8" language="java" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<head><title>Booking Details — Manager</title></head><main class="pc-page"><div class="editorial-container pc-container-admin"><jsp:include page="fragments/manager-navbar.jsp"/><jsp:include page="fragments/manager-messages.jsp"/><a href="${pageContext.request.contextPath}/manager/bookings">← Back to List</a><h1 class="editorial-title">Booking #${booking.id}</h1>
<div class="pc-card"><p><strong>Status:</strong> <c:out value="${booking.status}"/></p><p><strong>Client:</strong> <c:out value="${booking.customer.fullName}"/></p><p><strong>Photographer:</strong> <c:out value="${booking.photographerProfile.displayName}"/></p><p><strong>Date &amp; Time:</strong> <c:out value="${booking.bookingDate}"/> <c:out value="${booking.bookingTime}"/></p><p><strong>Location:</strong> <c:out value="${booking.location}"/></p><p><strong>Package:</strong> <c:out value="${booking.packageName}"/></p><p><strong>Agreed Price:</strong> <c:out value="${booking.agreedPrice}"/></p><p class="text-muted">Manager staff cannot view private client-creator chats or raw deliveries from this console.</p></div>
<c:if test="${booking.status == 'DISPUTED'}"><form class="pc-card mt-3" method="post" action="${pageContext.request.contextPath}/manager/bookings/${booking.id}/resolve-dispute"><%@ include file="fragments/csrf-input.jsp" %><label for="resolution">Dispute Outcome</label><select id="resolution" name="resolution" class="form-select"><option value="REFUND_CUSTOMER">Refund Escrow Deposit to Customer</option><option value="PAY_PHOTOGRAPHER">Release Escrow to Photographer</option></select><label for="notes">Investigation Findings &amp; Rationale</label><textarea id="notes" name="notes" required maxlength="1000" class="form-control"></textarea><button class="btn btn-primary mt-2">Resolve Dispute</button></form></c:if>
</div></main>
