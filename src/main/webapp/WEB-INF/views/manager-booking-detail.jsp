<%@ page contentType="text/html;charset=UTF-8" language="java" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<head><title>Chi tiết booking — Manager</title></head><main class="pc-page"><div class="editorial-container pc-container-admin"><jsp:include page="fragments/manager-navbar.jsp"/><jsp:include page="fragments/manager-messages.jsp"/><a href="${pageContext.request.contextPath}/manager/bookings">← Danh sách</a><h1 class="editorial-title">Booking #${booking.id}</h1>
<div class="pc-card"><p><strong>Trạng thái:</strong> <c:out value="${booking.status}"/></p><p><strong>Khách hàng:</strong> <c:out value="${booking.customer.fullName}"/></p><p><strong>Nhiếp ảnh gia:</strong> <c:out value="${booking.photographerProfile.displayName}"/></p><p><strong>Lịch:</strong> <c:out value="${booking.bookingDate}"/> <c:out value="${booking.bookingTime}"/></p><p><strong>Địa điểm:</strong> <c:out value="${booking.location}"/></p><p><strong>Gói:</strong> <c:out value="${booking.packageName}"/></p><p><strong>Giá đã chốt:</strong> <c:out value="${booking.agreedPrice}"/></p><p class="text-muted">Manager không được xem chat riêng hoặc ảnh giao riêng tư từ màn hình này.</p></div>
<c:if test="${booking.status == 'DISPUTED'}"><form class="pc-card mt-3" method="post" action="${pageContext.request.contextPath}/manager/bookings/${booking.id}/resolve-dispute"><%@ include file="fragments/csrf-input.jsp" %><label for="resolution">Kết quả theo chính sách</label><select id="resolution" name="resolution" class="form-select"><option value="REFUND_CUSTOMER">Hoàn đặt cọc mô phỏng cho khách</option><option value="PAY_PHOTOGRAPHER">Đóng booking cho nhiếp ảnh gia</option></select><label for="notes">Căn cứ điều tra</label><textarea id="notes" name="notes" required maxlength="1000" class="form-control"></textarea><button class="btn btn-primary mt-2">Giải quyết tranh chấp</button></form></c:if>
</div></main>
