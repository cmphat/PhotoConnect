<%@ page contentType="text/html;charset=UTF-8" language="java" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<head><title>Báo cáo vi phạm — Manager</title></head><main class="pc-page"><div class="editorial-container pc-container-admin"><jsp:include page="fragments/manager-navbar.jsp"/><h1 class="editorial-title">Báo cáo vi phạm</h1><jsp:include page="fragments/manager-messages.jsp"/>
<form method="get" class="admin-filter-panel"><select name="status" class="form-select"><option value="ALL">Tất cả trạng thái</option><c:forEach var="s" items="${statuses}"><option value="${s}" ${selectedStatus == s.name() ? 'selected' : ''}>${s}</option></c:forEach></select><button class="btn btn-primary">Lọc</button></form>
<div class="admin-table-shell"><table class="admin-table"><thead><tr><th>ID</th><th>Người báo cáo</th><th>Loại</th><th>Booking</th><th>Trạng thái</th><th>Manager</th><th></th></tr></thead><tbody><c:forEach var="r" items="${reports}"><tr><td>#${r.id}</td><td><c:out value="${r.reporter.fullName}"/></td><td><c:out value="${r.category}"/></td><td><c:out value="${r.booking.id}"/></td><td><c:out value="${r.status}"/></td><td><c:out value="${r.assignedManager.fullName}"/></td><td><a class="btn btn-secondary btn-sm" href="${pageContext.request.contextPath}/manager/reports/${r.id}">Xem</a></td></tr></c:forEach><c:if test="${empty reports}"><tr><td colspan="7">Không có báo cáo.</td></tr></c:if></tbody></table></div>
<nav class="d-flex justify-content-between mt-3" aria-label="Phân trang"><c:if test="${currentPage > 0}"><a class="btn btn-secondary btn-sm" href="${pageContext.request.contextPath}/manager/reports?status=${selectedStatus}&page=${currentPage - 1}">Trang trước</a></c:if><span>Trang ${currentPage + 1}/${totalPages}</span><c:if test="${currentPage + 1 < totalPages}"><a class="btn btn-secondary btn-sm" href="${pageContext.request.contextPath}/manager/reports?status=${selectedStatus}&page=${currentPage + 1}">Trang sau</a></c:if></nav>
</div></main>
