<%@ page contentType="text/html;charset=UTF-8" language="java" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<head><title>Safety Reports — Manager</title></head><main class="pc-page"><div class="editorial-container pc-container-admin"><jsp:include page="fragments/manager-navbar.jsp"/><h1 class="editorial-title">Safety Reports &amp; Violations</h1><jsp:include page="fragments/manager-messages.jsp"/>
<form method="get" class="admin-filter-panel"><select name="status" class="form-select"><option value="ALL">All Statuses</option><c:forEach var="s" items="${statuses}"><option value="${s}" ${selectedStatus == s.name() ? 'selected' : ''}>${s}</option></c:forEach></select><button class="btn btn-primary">Filter</button></form>
<div class="admin-table-shell"><table class="admin-table"><thead><tr><th>ID</th><th>Reporter</th><th>Category</th><th>Booking</th><th>Status</th><th>Assigned Manager</th><th>Actions</th></tr></thead><tbody><c:forEach var="r" items="${reports}"><tr><td>#${r.id}</td><td><c:out value="${r.reporter.fullName}"/></td><td><c:out value="${r.category}"/></td><td><c:out value="${r.booking.id}"/></td><td><c:out value="${r.status}"/></td><td><c:out value="${r.assignedManager.fullName}"/></td><td><a class="btn btn-secondary btn-sm" href="${pageContext.request.contextPath}/manager/reports/${r.id}">View</a></td></tr></c:forEach><c:if test="${empty reports}"><tr><td colspan="7">No reports found.</td></tr></c:if></tbody></table></div>
<nav class="d-flex justify-content-between mt-3" aria-label="Pagination"><c:if test="${currentPage > 0}"><a class="btn btn-secondary btn-sm" href="${pageContext.request.contextPath}/manager/reports?status=${selectedStatus}&page=${currentPage - 1}">Previous</a></c:if><span>Page ${currentPage + 1} of ${totalPages}</span><c:if test="${currentPage + 1 < totalPages}"><a class="btn btn-secondary btn-sm" href="${pageContext.request.contextPath}/manager/reports?status=${selectedStatus}&page=${currentPage + 1}">Next</a></c:if></nav>
</div></main>
