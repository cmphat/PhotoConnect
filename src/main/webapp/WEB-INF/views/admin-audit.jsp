<%@ page contentType="text/html;charset=UTF-8" language="java" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<head><title>Operational Audit — Admin</title></head><main class="pc-page"><div class="editorial-container pc-container-admin"><jsp:include page="fragments/admin-navbar.jsp"/><h1 class="editorial-title">Operational Audit</h1><p class="text-muted">Immutable Manager and Administrator actions. No edit/delete endpoint is exposed.</p><div class="admin-table-shell"><table class="admin-table"><thead><tr><th>Time</th><th>Actor</th><th>Role</th><th>Action</th><th>Target</th><th>Outcome</th><th>Summary</th></tr></thead><tbody><c:forEach var="log" items="${logs}"><tr><td><c:out value="${log.createdAt}"/></td><td><c:out value="${log.actor.fullName}"/></td><td><c:out value="${log.actorRole}"/></td><td><c:out value="${log.action}"/></td><td><c:out value="${log.targetType}"/> #<c:out value="${log.targetId}"/></td><td><c:out value="${log.outcome}"/></td><td><c:out value="${log.summary}"/></td></tr></c:forEach><c:if test="${empty logs}"><tr><td colspan="7">No operational audit records.</td></tr></c:if></tbody></table></div></div></main>
