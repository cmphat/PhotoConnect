<%@ page contentType="text/html;charset=UTF-8" language="java" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<head><title>Support Ticket — PhotoConnect</title></head><main class="pc-page"><div class="editorial-container"><a href="${pageContext.request.contextPath}/support">← Help Center</a><h1 class="editorial-title">#${ticket.id} — <c:out value="${ticket.subject}"/></h1><jsp:include page="fragments/manager-messages.jsp"/><div class="pc-card"><p><strong>Status:</strong> <c:out value="${ticket.status}"/></p><p><strong>Category:</strong> <c:out value="${ticket.category}"/></p><p><c:out value="${ticket.description}"/></p></div><div class="pc-card mt-3"><c:forEach var="m" items="${messages}"><div class="border-bottom py-2"><strong><c:out value="${m.author.fullName}"/></strong><br/><c:out value="${m.message}"/></div></c:forEach></div>
<c:choose><c:when test="${ticket.status == 'RESOLVED'}"><form method="post" action="${pageContext.request.contextPath}/support/${ticket.id}/reopen" class="pc-card mt-3"><%@ include file="fragments/csrf-input.jsp" %><label for="reopen">Reason to Reopen</label><textarea id="reopen" name="message" required maxlength="2000" class="form-control"></textarea><button class="btn btn-secondary mt-2">Reopen Ticket</button></form></c:when><c:otherwise><form method="post" action="${pageContext.request.contextPath}/support/${ticket.id}/reply" class="pc-card mt-3"><%@ include file="fragments/csrf-input.jsp" %><label for="reply">Your Reply</label><textarea id="reply" name="message" required maxlength="2000" class="form-control"></textarea><button class="btn btn-primary mt-2">Send Reply</button></form></c:otherwise></c:choose>
</div></main>
