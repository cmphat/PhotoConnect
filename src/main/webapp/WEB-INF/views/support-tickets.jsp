<%@ page contentType="text/html;charset=UTF-8" language="java" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<head><title>Support Center — PhotoConnect</title></head><main class="pc-page"><div class="editorial-container"><h1 class="editorial-title">Help &amp; Support Center</h1><jsp:include page="fragments/manager-messages.jsp"/>
<div class="row g-4"><div class="col-lg-5"><form method="post" action="${pageContext.request.contextPath}/support" class="pc-card"><%@ include file="fragments/csrf-input.jsp" %><h2 class="h4">Submit a Ticket</h2><label for="category">Category</label><select id="category" name="category" class="form-select"><c:forEach var="c" items="${categories}"><option value="${c}">${c}</option></c:forEach></select><label for="subject">Subject</label><input id="subject" name="subject" maxlength="200" required class="form-control"/><label for="description">Description</label><textarea id="description" name="description" maxlength="2000" required class="form-control"></textarea><button class="btn btn-primary mt-2">Submit Ticket</button></form></div><div class="col-lg-7"><div class="pc-card"><h2 class="h4">My Tickets</h2><c:forEach var="t" items="${tickets}"><a class="d-block border-bottom py-3" href="${pageContext.request.contextPath}/support/${t.id}"><strong>#${t.id} — <c:out value="${t.subject}"/></strong><br/><small><c:out value="${t.status}"/> · <c:out value="${t.updatedAt}"/></small></a></c:forEach><c:if test="${empty tickets}"><p class="text-muted">You have not submitted any support tickets yet.</p></c:if><nav class="d-flex justify-content-between mt-3" aria-label="Pagination"><c:if test="${currentPage > 0}"><a class="btn btn-secondary btn-sm" href="${pageContext.request.contextPath}/support?page=${currentPage - 1}">Previous</a></c:if><span>Page ${currentPage + 1} of ${totalPages}</span><c:if test="${currentPage + 1 < totalPages}"><a class="btn btn-secondary btn-sm" href="${pageContext.request.contextPath}/support?page=${currentPage + 1}">Next</a></c:if></nav></div></div></div>
</div></main>
