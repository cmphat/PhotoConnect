# Photo Connect – Vercel container preview (Java 21 / Spring Boot WAR / JSP).
# Builds the real Java application; it is NOT a static HTML mock.
FROM maven:3.9.11-eclipse-temurin-21 AS build
WORKDIR /workspace
COPY pom.xml ./
COPY src ./src
RUN mvn -B -ntp -DskipTests package

FROM eclipse-temurin:21-jre
WORKDIR /app
COPY --from=build /workspace/target/photoconnect.war /app/photoconnect.war
# Vercel container Functions listen on PORT (defaults to 80).
EXPOSE 80
CMD ["sh", "-c", "exec java -Dserver.port=${PORT:-80} -jar /app/photoconnect.war"]
